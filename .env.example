DISCORD_TOKEN=your-bot-token-here
# Optional: your test server's ID for instant slash-command sync
DEV_GUILD_ID=
# Optional: Instagram embed proxy host (default fxinstagram.com)
EMBED_DOMAIN=
# Optional: where VC emoji assignments are stored (default: vc_emojis.json in the folder you run the bot from)
VC_EMOJI_FILE=
# Optional: local arrival clip (default: join.mp3 in the folder you run the bot from)
JOIN_SOUND_FILE=
# Optional: saved per-server feature toggles (default: feature_settings.json)
FEATURE_SETTINGS_FILE=
# Optional: saved playback panel message references, reused after restart (default: playback_panels.json)
PLAYBACK_PANEL_FILE=
# Optional: separation engine: mdx (recommended default) or demucs (quality alternative).
KARAOKE_BACKEND=mdx
# Optional: compute device: auto, cpu, or cuda (CUDA/ROCm PyTorch required for GPU).
# Follow the selected engine's GPU setup, then set cuda to require GPU without CPU fallback.
KARAOKE_DEVICE=auto
# Optional, Demucs only: prediction shifts (non-negative integer); 0 skips shift augmentation.
KARAOKE_SHIFTS=1
# Optional, Demucs only: segment overlap from 0 (inclusive) to 1 (exclusive).
# For faster preparation, try KARAOKE_SHIFTS=0 and KARAOKE_OVERLAP=0.1.
# Reduced augmentation/overlap can worsen separation quality or transitions.
KARAOKE_OVERLAP=0.25
# Optional, MDX only: model cache directory (default: ~/.cache/discord-vc-bot/models).
KARAOKE_MODEL_DIR=
