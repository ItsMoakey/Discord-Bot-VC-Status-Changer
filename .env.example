DISCORD_TOKEN=your-bot-token-here
# Optional: your test server's ID for instant slash-command sync
DEV_GUILD_ID=
# Optional: Instagram embed proxy host (default fxinstagram.com)
EMBED_DOMAIN=
# Optional: where VC emoji assignments are stored (default: vc_emojis.json in the folder you run the bot from)
VC_EMOJI_FILE=
# Optional: local arrival clip (default: join.mp3 in the folder you run the bot from)
JOIN_SOUND_FILE=
# Optional: saved per-server /joinsound toggles (default: join_sound_settings.json)
JOIN_SOUND_SETTINGS_FILE=
